    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="ErrorOr" Version="2.1.1" />
    <PackageReference Include="ApiHub" Version="0.1.2" />
    <PackageReference Include="ApiHub.ChatClient" Version="0.1.2" />
