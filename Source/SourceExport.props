<Project>
    <PropertyGroup>
        <!-- 导出资料的仓库根，Link 据此保留仓库相对路径 -->
        <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))</RepoRoot>
    </PropertyGroup>

    <!-- 产物随附仓库源码与文档，运行时按 source 路径查阅；Link 决定产物内的相对路径 -->
    <ItemGroup>
        <None
            Include="$(RepoRoot)/Source/**/*.cs;$(RepoRoot)/Source/**/*.csproj;$(RepoRoot)/Tests/**/*.cs;$(RepoRoot)/Tests/**/*.csproj;$(RepoRoot)/docs/**/*.md"
            Exclude="$(RepoRoot)/**/bin/**;$(RepoRoot)/**/obj/**;$(RepoRoot)/**/TestResults/**"
            Link="source/$([MSBuild]::MakeRelative($(RepoRoot), %(FullPath)))"
            CopyToOutputDirectory="PreserveNewest" />
        <None
            Include="$(RepoRoot)/README.md;$(RepoRoot)/LICENSE;$(RepoRoot)/Kuroe.slnx;$(RepoRoot)/Directory.Build.props;$(RepoRoot)/Directory.Packages.props;$(RepoRoot)/Source/SourceExport.props;$(RepoRoot)/nuget.config;$(RepoRoot)/.editorconfig"
            Link="source/$([MSBuild]::MakeRelative($(RepoRoot), %(FullPath)))"
            CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>